#pragma kernel EncodeBc7Fast BC7_FAST
#pragma kernel EncodeBc7Balanced BC7_BALANCED
#pragma kernel EncodeBc7HighQuality BC7_HIGH
#pragma target 5.0

// One thread per 4x4 block. HighQuality searches two-subset modes with separate subset endpoints and a defined seed score.
Texture2D<float4> _Source;
RWStructuredBuffer<uint4> _Blocks;
int2 _Size;
uint _BlocksX, _ColorTransform, _FlipY, _BlockRowStart, _BlockRowCount;

float4 LoadColor(uint2 p)
{
    p=min(p,(uint2)(_Size-1));if(_FlipY!=0)p.y=_Size.y-1-p.y;
    float4 c=saturate(_Source.Load(int3(p,0)));
    if(_ColorTransform==1)
        c.rgb=float3(c.r<=.0031308?c.r*12.92:1.055*pow(c.r,1.0/2.4)-.055,
                     c.g<=.0031308?c.g*12.92:1.055*pow(c.g,1.0/2.4)-.055,
                     c.b<=.0031308?c.b*12.92:1.055*pow(c.b,1.0/2.4)-.055);
    else if(_ColorTransform==2)
        c.rgb=float3(c.r<=.04045?c.r/12.92:pow((c.r+.055)/1.055,2.4),
                     c.g<=.04045?c.g/12.92:pow((c.g+.055)/1.055,2.4),
                     c.b<=.04045?c.b/12.92:pow((c.b+.055)/1.055,2.4));
    return c*255;
}
float4 Rotate(float4 c,uint rotation)
{
    float4 result=c;
    if(rotation==1)result.ra=c.ar;
    else if(rotation==2)result.ga=c.ag;
    else if(rotation==3)result.ba=c.ab;
    return result;
}
uint Weight(uint index,uint bits)
{
    uint w=0;
    if(bits==2)w=(index*64+1)/3;else if(bits==3)w=(index*64+3)/7;else w=(index*64+7)/15;
    return w;
}
float4 Interpolate(float4 lo,float4 hi,uint index,uint bits)
{
    uint w=Weight(index,bits);
    return floor((lo*(64-w)+hi*w+32)/64);
}
float Error(float4 c,float4 v,uint channels)
{
    float4 d=c-v;
    if(channels==0)d.a=0;
    else if(channels==1)d.rgb=0;
    return dot(d,d);
}
uint FindIndex(float4 c,float4 lo,float4 hi,uint bits,uint channels)
{
    uint maximum=(1u<<bits)-1;
    uint first=0,last=maximum;
    float4 d=hi-lo,difference=c-lo;
    if(channels==0){d.a=0;difference.a=0;}
    else if(channels==1){d.rgb=0;difference.rgb=0;}
    float projection=saturate(dot(difference,d)/max(dot(d,d),1e-12));
    uint center=(uint)floor(projection*maximum+.5);
    first=center>0?center-1:0;last=min(maximum,center+1);
    float best=1e30;uint selected=0;
    [loop]for(uint index=first;index<=last;index++)
    {
        float e=Error(c,Interpolate(lo,hi,index,bits),channels);
        if(e<best){best=e;selected=index;}
    }
    return selected;
}
uint Expand(uint q,uint bits)
{
    uint v=q<<(8-bits);return v|(v>>bits);
}
uint Quantize(float v,uint bits)
{
    uint maxq=(1u<<bits)-1;
    uint center=(uint)floor(saturate(v/255)*maxq+.5),best=center;
    float error=abs((float)Expand(center,bits)-v);
    uint a=center>0?center-1:0,b=min(center+1,maxq);
    float ea=abs((float)Expand(a,bits)-v);
    if(ea<error){best=a;error=ea;}
    if(abs((float)Expand(b,bits)-v)<error)best=b;
    return best;
}
float4 Quantize6(float4 target,int boundaryAlpha)
{
    float4 best=0;float error=1e30;
    [unroll]for(uint p=0;p<2;p++)
    {
        if(boundaryAlpha>=0&&p!=((uint)boundaryAlpha&1))continue;
        float4 q=clamp(floor((target-p)/2+.5),0,127)*2+p;
        if(boundaryAlpha>=0)q.a=boundaryAlpha;
        float e=dot(q-target,q-target);
        if(e<error){best=q;error=e;}
    }
    return best;
}
void Put(inout uint4 block,uint value,uint bits,uint offset)
{
    uint word=offset>>5,shift=offset&31;
    uint low=(value&((1u<<bits)-1))<<shift;
    if(word==0)block.x|=low;else if(word==1)block.y|=low;else if(word==2)block.z|=low;else block.w|=low;
    if(shift+bits>32)
    {
        uint high=value>>(32-shift);
        if(word==0)block.y|=high;else if(word==1)block.z|=high;else if(word==2)block.w|=high;
    }
}
void Initial(uint2 origin,uint rotation,bool combined,out float4 lo,out float4 hi,out float4 sum)
{
    sum=0;float4 minimum=255,maximum=0,r=0,g=0,b=0,a=0;
    [loop]for(uint i=0;i<16;i++)
    {
        float4 c=Rotate(LoadColor(origin+uint2(i&3,i>>2)),rotation);
        sum+=c;minimum=min(minimum,c);maximum=max(maximum,c);
        r+=c.r*c;g+=c.g*c;b+=c.b*c;a+=c.a*c;
    }
    float4 mean=sum/16;r-=mean.r*sum;g-=mean.g*sum;b-=mean.b*sum;a-=mean.a*sum;
    float4 variance=max(0,float4(r.r,g.g,b.b,a.a));if(!combined)variance.a=-1;
    uint channel=variance.r>=variance.g?0:1;
    if(variance.b>variance[channel])channel=2;
    if(variance.a>variance[channel])channel=3;
    float4 axis=channel==0?float4(1,0,0,0):channel==1?float4(0,1,0,0):channel==2?float4(0,0,1,0):float4(0,0,0,1);
    [unroll]for(uint k=0;k<5;k++)
    {
        float4 next=float4(dot(r,axis),dot(g,axis),dot(b,axis),combined?dot(a,axis):0);
        axis=next*rsqrt(max(dot(next,next),1e-20));
    }
    float low=1e30,high=-1e30;
    [loop]for(uint j=0;j<16;j++)
    {
        float4 c=Rotate(LoadColor(origin+uint2(j&3,j>>2)),rotation);
        float v=dot(c-mean,axis);low=min(low,v);high=max(high,v);
    }
    lo=clamp(mean+axis*low,0,255);hi=clamp(mean+axis*high,0,255);
    if(!combined){lo.a=minimum.a;hi.a=maximum.a;}
}
void Fit(float4 sum,float4 weighted,float2 weights,float2 squared,out float4 lo,out float4 hi,float4 previousLo,float4 previousHi)
{
    float2 aa=16-2*weights+squared,ab=weights-squared,det=aa*squared-ab*ab;
    float4 ac=aa.xxxy,bc=ab.xxxy,cc=squared.xxxy,dd=det.xxxy;
    lo=clamp(lerp(previousLo,((sum-weighted)*cc-weighted*bc)/max(dd,1e-12),float4(dd>1e-6)),0,255);
    hi=clamp(lerp(previousHi,(weighted*ac-(sum-weighted)*bc)/max(dd,1e-12),float4(dd>1e-6)),0,255);
}
void Candidate(uint2 origin,uint mode,uint rotation,uint selector,int boundaryAlpha,inout float bestError,inout uint4 bestBlock)
{
    bool combined=mode==6;
    uint colorBits=mode==6?4:mode==5?2:selector==0?2:3;
    uint alphaBits=mode==4?(selector==0?3:2):mode==5?2:4;
    float4 targetLo=0,targetHi=0,sum=0;
    Initial(origin,rotation,combined,targetLo,targetHi,sum);
#if defined(BC7_FAST)
    const uint iterations=2;
#elif defined(BC7_HIGH)
    const uint iterations=6;
#else
    const uint iterations=3;
#endif
    [loop]for(uint iteration=0;iteration<iterations;iteration++)
    {
        float4 lo=0,hi=0;uint4 qlo=0,qhi=0;
        if(combined){lo=Quantize6(targetLo,boundaryAlpha);hi=Quantize6(targetHi,boundaryAlpha);}
        else
        {
            [unroll]for(uint c=0;c<4;c++)
            {
                uint precision=c==3?(mode==5?8:6):(mode==5?7:5);
                qlo[c]=Quantize(targetLo[c],precision);qhi[c]=Quantize(targetHi[c],precision);
                lo[c]=Expand(qlo[c],precision);hi[c]=Expand(qhi[c],precision);
            }
        }
        float4 first=Rotate(LoadColor(origin),rotation);
        uint ci=FindIndex(first,lo,hi,colorBits,combined?2:0);
        if(ci>=(1u<<(colorBits-1)))
        {
            float4 t=lo;uint4 tq=qlo;
            if(combined){lo=hi;hi=t;}
            else{lo.rgb=hi.rgb;hi.rgb=t.rgb;qlo.rgb=qhi.rgb;qhi.rgb=tq.rgb;}
        }
        if(!combined&&FindIndex(first,lo,hi,alphaBits,1)>=(1u<<(alphaBits-1)))
        {
            float t=lo.a;lo.a=hi.a;hi.a=t;uint tq=qlo.a;qlo.a=qhi.a;qhi.a=tq;
        }
        uint4 block=0;Put(block,1u<<mode,mode+1,0);
        uint start=mode+1;
        if(!combined){Put(block,rotation,2,start);start+=2;if(mode==4){Put(block,selector,1,start);start++;}}
        [unroll]for(uint c2=0;c2<4;c2++)
        {
            uint precision=combined?7:c2==3?(mode==5?8:6):(mode==5?7:5);
            Put(block,combined?((uint)lo[c2]>>1):qlo[c2],precision,start);start+=precision;
            Put(block,combined?((uint)hi[c2]>>1):qhi[c2],precision,start);start+=precision;
        }
        if(combined){Put(block,(uint)lo.r&1,1,start++);Put(block,(uint)hi.r&1,1,start++);}
        uint colorAt=start,alphaAt=combined?start:mode==5?start+31:selector==0?start+31:start;
        if(mode==4&&selector==1)colorAt=start+31;
        float error=0;float2 sw=0,sww=0;float4 swc=0;
        [loop]for(uint i2=0;i2<16;i2++)
        {
            float4 color=Rotate(LoadColor(origin+uint2(i2&3,i2>>2)),rotation);
            uint index=FindIndex(color,lo,hi,colorBits,combined?2:0);
            uint ai=combined?index:FindIndex(color,lo,hi,alphaBits,1);
            float4 decoded=Interpolate(lo,hi,index,colorBits);
            if(!combined)decoded.a=Interpolate(lo,hi,ai,alphaBits).a;
            float4 difference=color-decoded;error+=dot(difference,difference);
            uint cbits=colorBits-(i2==0?1:0);Put(block,index,cbits,colorAt);colorAt+=cbits;
            if(!combined){uint abits=alphaBits-(i2==0?1:0);Put(block,ai,abits,alphaAt);alphaAt+=abits;}
            float2 w=float2(Weight(index,colorBits),Weight(ai,alphaBits))/64.0;
            sw+=w;sww+=w*w;swc+=color*w.xxxy;
        }
        if(error<bestError){bestError=error;bestBlock=block;}
        Fit(sum,swc,sw,sww,targetLo,targetHi,lo,hi);
    }
}
#if defined(BC7_HIGH)
#include "Bc7HighQuality.hlsl"
#endif
#if defined(BC7_FAST)
#define BC7_ENTRY EncodeBc7Fast
#elif defined(BC7_HIGH)
#define BC7_ENTRY EncodeBc7HighQuality
#else
#define BC7_ENTRY EncodeBc7Balanced
#endif
#if defined(BC7_HIGH)
[numthreads(8,4,1)]
#else
[numthreads(8,4,1)]
#endif
void BC7_ENTRY(uint3 id:SV_DispatchThreadID)
{
    if(id.y>=_BlockRowCount)return;
    id.y+=_BlockRowStart;
    uint2 extent=((uint2)_Size+3)/4;if(any(id.xy>=extent))return;
    uint2 origin=id.xy*4;float minimumAlpha=255;float4 lo=255,hi=0;
    [unroll]for(uint i=0;i<16;i++){float4 c=LoadColor(origin+uint2(i&3,i>>2));minimumAlpha=min(minimumAlpha,c.a);lo=min(lo,c);hi=max(hi,c);}
    bool opaque=minimumAlpha>=254.9999;
    int boundaryAlpha=opaque?255:hi.a<=.0001?0:-1;
    float error=1e30;uint4 best=0;
#if defined(BC7_HIGH)
    best=_Blocks[id.y*_BlocksX+id.x];error=BalancedError(origin,best);
#endif
    Candidate(origin,6,0,0,boundaryAlpha,error,best);
#if defined(BC7_FAST)
    if(!opaque||all(hi-lo<.001))Candidate(origin,5,0,0,boundaryAlpha,error,best);
#else
    [loop]for(uint rotation=0;rotation<4;rotation++)
    {
        Candidate(origin,5,rotation,0,boundaryAlpha,error,best);
        Candidate(origin,4,rotation,0,boundaryAlpha,error,best);
        Candidate(origin,4,rotation,1,boundaryAlpha,error,best);
    }
#endif
#if defined(BC7_HIGH)
    SearchPartitions(origin,opaque,error,best);
#endif
    _Blocks[id.y*_BlocksX+id.x]=best;
}



